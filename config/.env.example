# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

GROQ_API_KEY=your_groq_api_key_here

# Supabase Postgres connection string (Transaction pooler recommended).
# If unset, falls back to an in-memory store (documents lost on restart).
SUPABASE_DB_URL=postgresql://postgres.xxxxx:yourpassword@aws-x-xx-xxxx-x.pooler.supabase.com:6543/postgres

# Optional — forces embedding backend. Leave unset to auto-detect
# (uses sentence-transformers if reachable, else falls back to TF-IDF for local dev).
# EMBEDDING_BACKEND=sentence-transformers
